# --- Monochrome self-hosting: copy to `.env` (same folder) and fill in ---
# `docker compose` reads `.env` from the directory you run it in, so run from
# this docker/ folder:  cd docker && docker compose up -d --build
#
# .env is gitignored -- your secret will NOT be committed.

# Public URLs as reached THROUGH your reverse proxy (must be https for the
# cross-subdomain auth cookie to work). On a Tailscale/NetBird mesh these are
# your MagicDNS / mesh hostnames, e.g. https://music.tailnet-name.ts.net
AUTH_URL=https://auth.<your-domain>
FRONTEND_ORIGIN=https://music.<your-domain>

# Session signing secret. Generate once and keep it stable:
#   openssl rand -hex 32
AUTH_SECRET=

# Server-side login wall (vite-preview only). Leave false: the frontend is
# served by nginx here, so `true` would 404 on /login. Accounts + sync still
# work fully as an optional sign-in with this off.
AUTH_ENABLED=false

# Which sign-in methods the Accounts panel shows.
AUTH_EMAIL_ENABLED=true
AUTH_GOOGLE_ENABLED=false

# Host ports (loopback-only; point your reverse proxy at these).
#   music.<domain> -> 127.0.0.1:4472
#   auth.<domain>  -> 127.0.0.1:4480
MONOCHROME_PORT=4472
AUTH_PORT=4480
